# Copy to .env and fill in. Generators: openssl rand -hex 32 (secrets), openssl rand -hex 16 (passwords).
STRATA_SERVER_MORGOTH_KEY=   # strata's api_key (the "api_key" field in your strata-<model>.json)
LITELLM_MASTER_KEY=sk-       # admin key for the LiteLLM proxy and its /ui
LITELLM_SALT_KEY=sk-         # encrypts provider keys stored in the DB; never change after first start
POSTGRES_PASSWORD=
ADMIN_TOKEN=                 # password for the strata control page on :2027 (caddy injects it behind the login page)
HOMEPAGE_ALLOWED_HOSTS=*     # set to your public hostname, e.g. host.tailnet.ts.net
WEB_USER=                    # login page user
WEB_PASSWORD=                # login page password (compared in constant time by auth/server.py)
AUTH_SECRET=                 # signs the session cookie; changing it logs everyone out
