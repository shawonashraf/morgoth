# Single door for every service. Plain HTTP on 127.0.0.1:2023; Tailscale Funnel terminates TLS in front.
{
	default_bind 127.0.0.1
}

# Login page + session cookie, served by auth/server.py (see /auth/login, /auth/logout)
(login) {
	forward_auth 127.0.0.1:2024 {
		uri /auth/verify
	}
}

http://:2023 {
	handle /auth/* {
		reverse_proxy 127.0.0.1:2024
	}

	# LiteLLM keeps its own keys and UI login (SERVER_ROOT_PATH=/litellm, so no prefix stripping)
	handle /litellm/* {
		reverse_proxy 127.0.0.1:4000
	}

	redir /admin /admin/
	redir /strata /strata/

	# Control page: the login above replaces the page's own token prompt
	handle /admin/* {
		route { # route keeps this order: check the login on the full path, then strip the prefix
			import login
			uri strip_prefix /admin
			reverse_proxy 127.0.0.1:2027 {
				header_up Authorization "Bearer {$ADMIN_TOKEN}"
			}
		}
	}

	# Strata's own chat UI (asks for the strata API key itself)
	handle /strata/* {
		route {
			import login
			uri strip_prefix /strata
			reverse_proxy 127.0.0.1:2026
		}
	}

	handle {
		import login
		reverse_proxy 127.0.0.1:3000
	}
}
