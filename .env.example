STRATA_SERVER_MORGOTH_KEY=   # strata's api_key (same as strata-iq3_s.json)
LITELLM_MASTER_KEY=sk-...    # admin key for the LiteLLM proxy and its /ui
LITELLM_SALT_KEY=sk-...      # encrypts provider keys stored in the DB; never change after first start
POSTGRES_PASSWORD=
ADMIN_TOKEN=                 # password for the strata control page (user: admin)
HOMEPAGE_ALLOWED_HOSTS=*     # set to your domain once the cloudflare tunnel exists
WEB_USER=                    # login for the homepage / control page behind caddy
WEB_PASSWORD=                # checked by the login page (auth/server.py)
AUTH_SECRET=                 # signs the session cookie; openssl rand -hex 32. Changing it logs everyone out
